{
  "name": "aliatlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "worker": "node --env-file-if-exists=.env.local scripts/worker.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/create-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "busboy": "1.6.0",
    "dicom-parser": "1.8.21",
    "next": "16.3.5",
    "nifti-reader-js": "0.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "prettier": "3.6.2"
  }
}
