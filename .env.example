# Local, persistent storage. Keep outside public/ and outside Git.
ATLAS_DATA_DIR=./data
NEXT_TELEMETRY_DISABLED=1

# Start the Node worker separately after installing the model runtime.
ATLAS_AI_ENABLED=false
# Queue labels for the largest eligible CT stack immediately after each upload.
ATLAS_AUTO_LABEL_ON_IMPORT=false
ATLAS_PYTHON_BIN=python3
ATLAS_TOTALSEG_BIN=TotalSegmentator
ATLAS_GDCM_BIN=gdcmconv
ATLAS_AI_DEVICE=cpu
# Lower-resolution inference for the total task only. Detailed head/neck tasks stay full resolution.
ATLAS_AI_FAST=true
# Per-model task timeout: 30 minutes.
ATLAS_AI_TIMEOUT_MS=1800000

# Set these when running behind your own HTTPS reverse proxy.
# ATLAS_PUBLIC_ORIGIN=https://atlas.example.com
# ATLAS_COOKIE_SECURE=true
