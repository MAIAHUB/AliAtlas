# Local, persistent storage. Keep outside public/ and outside Git.
ATLAS_DATA_DIR=./data
NEXT_TELEMETRY_DISABLED=1

# Accounts, sessions and archive ownership (PostgreSQL). `docker compose up -d postgres orthanc`
# starts both services for local development with these defaults.
DATABASE_URL=postgres://aliatlas:aliatlas-dev-password@127.0.0.1:5432/aliatlas
# Orthanc DICOM archive. Leave ORTHANC_URL empty to keep uploads only in ATLAS_DATA_DIR.
ORTHANC_URL=http://127.0.0.1:8042
ORTHANC_USERNAME=aliatlas
ORTHANC_PASSWORD=aliatlas-dev-password
# Used by compose.yaml. Change both passwords for anything beyond local development
# (use URL-safe characters; POSTGRES_PASSWORD is embedded in DATABASE_URL).
POSTGRES_PASSWORD=aliatlas-dev-password
# Host port for the Compose Postgres. Change it (and DATABASE_URL) if 5432 is already in use.
POSTGRES_PORT=5432

# Start the Node worker separately after installing the model runtime.
ATLAS_AI_ENABLED=false
# Queue labels for the largest eligible CT stack immediately after each upload.
ATLAS_AUTO_LABEL_ON_IMPORT=false
ATLAS_PYTHON_BIN=python3
ATLAS_TOTALSEG_BIN=TotalSegmentator
ATLAS_GDCM_BIN=gdcmconv
ATLAS_AI_DEVICE=cpu
# Lower-resolution inference for the total task only. Detailed head/neck tasks stay full resolution.
ATLAS_AI_FAST=true
# Per-model task timeout: 30 minutes.
ATLAS_AI_TIMEOUT_MS=1800000

# Set these when running behind your own HTTPS reverse proxy.
# Comma-separated list of browser origins allowed to write.
# ATLAS_PUBLIC_ORIGIN=https://atlas.example.com
# ATLAS_COOKIE_SECURE=true

# Automated abnormality detection and report drafting (server-side only; never exposed to the browser).
# Put the real key in .env or .env.local, never here: this file is committed.
# Leave BAI_API_KEY empty to disable. Only rendered slice pixels are sent, no DICOM headers.
BAI_API_KEY=
BAI_BASE_URL=
# Must accept images.
BAI_MODEL=
# Request format: 'openai' (chat completions with image_url parts).
BAI_API_STYLE=openai
