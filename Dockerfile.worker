FROM node:22-bookworm-slim
WORKDIR /app
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
ARG TORCH_VERSION=2.8.0
ARG TOTALSEG_VERSION=2.11.0
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv dcm2niix libgdcm-tools libgomp1 && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/anatomy
ENV PATH=/opt/anatomy/bin:$PATH
RUN pip install --no-cache-dir torch==${TORCH_VERSION} --index-url ${TORCH_INDEX_URL} && pip install --no-cache-dir TotalSegmentator==${TOTALSEG_VERSION}
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY lib ./lib
COPY scripts/worker.mjs ./scripts/worker.mjs
RUN mkdir -p /app/data && chown -R node:node /app
ENV ATLAS_DATA_DIR=/app/data ATLAS_AI_DEVICE=cpu ATLAS_AI_FAST=true TOTALSEG_HOME_DIR=/app/data/models
USER node
CMD ["node", "scripts/worker.mjs"]
